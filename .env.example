# Database Configuration
POSTGRES_USER=neuroboost
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=neuroboost

# API Configuration
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32
NODE_ENV=production
FRONTEND_URL=https://neuroboost.website

# Telegram Bots
TELEGRAM_BOT_TOKEN=YOUR_MAIN_BOT_TOKEN
TELEGRAM_NOTIFICATION_BOT_TOKEN=YOUR_NOTIFICATION_BOT_TOKEN

# Shared secret between the API and the notifier bot, guarding /api/svc/*.
# Generate with `openssl rand -hex 32`. Set the SAME value on both sides.
# Unset closes those endpoints (503) rather than opening them.
# These endpoints return every user's tg_id and message text, and once the bot
# runs on a foreign host they are reachable from the public internet — this
# token is the only thing in the way.
SERVICE_TOKEN=

# Optional: Context7 API Key (for higher rate limits)
# CONTEXT7_API_KEY=your_api_key_from_context7.com