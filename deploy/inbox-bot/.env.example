# /opt/neuroboost-inbox-bot/.env on nl-2. Never in git.
# From @BotFather (/newbot). Its own token — NOT the main bot's.
INBOX_BOT_TOKEN=
# Denis's Telegram id: the only one the bot answers.
INBOX_OWNER_TG_ID=
# Same value as INBOX_API_TOKEN in the API's .env.
INBOX_API_TOKEN=
# https://dev.neuroboost.space while trying it, https://neuroboost.space for real.
API_BASE=https://dev.neuroboost.space
# Project buttons; any other #word still becomes a project.
# INBOX_PROJECTS=neuroboost,avocar,archifex,harness,graph
# Raise only after nginx allows bigger bodies on /api/inbox (default 950000).
# INBOX_MAX_UPLOAD_BYTES=
